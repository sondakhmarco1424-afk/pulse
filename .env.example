# Copy this file to .env and replace every required blank value before starting Compose.
# Never commit the resulting .env file.

# Compose and images
COMPOSE_PROJECT_NAME=pulse
PULSE_NETWORK_NAME=pulse-system-net
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:8.2-alpine
KAFKA_IMAGE=confluentinc/cp-kafka:7.4.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
REDIS_INSIGHT_IMAGE=redis/redisinsight:latest

# Host bindings (loopback-only by default)
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6380
REDIS_INSIGHT_HOST_PORT=5540
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_HOST_PORT=29092
KAFKA_UI_HOST_PORT=8080
API_HOST_PORT=8081
FRONTEND_HOST_PORT=3000
DEV_API_HOST_PORT=8082
DEV_FRONTEND_HOST_PORT=8083

# Database: required secrets intentionally have no defaults
DB_HOST=pulse_app_db
DB_PORT=3306
DB_USER=pulse
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_SCHEMA=pulse_system
DB_SCHEMA_DEV=pulse_system_dev

# Redis: required secret intentionally has no default
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_EXPIRY_MINUTES=7
REDIS_MAX_RETRIES=5
REDIS_DIAL_TIMEOUT_SECONDS=5
REDIS_READ_TIMEOUT_SECONDS=3
REDIS_WRITE_TIMEOUT_SECONDS=3
REDIS_POOL_TIMEOUT_SECONDS=5
REDIS_RECONNECT_MIN_SECONDS=1
REDIS_RECONNECT_MAX_SECONDS=30

# Binance public market-data streams
BINANCE_WS_URL=wss://data-stream.binance.vision:443/ws
BINANCE_RECONNECT_DELAY_SECONDS=5
VITE_BINANCE_WS_URL=wss://data-stream.binance.vision:443/stream?streams=btcusdt@ticker/ethusdt@ticker/bnbusdt@ticker/solusdt@ticker
VITE_BINANCE_REST_BASE_URL=https://data-api.binance.vision/api/v3

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_FCM_NOTIFICATIONS_TOPIC=fcm-notifications
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_ADVERTISED_HOST=localhost

# Backend
APP_ENV=production
APP_ENABLE_AUTH=true
SERVER_PORT=8081

# Firebase Admin credentials stay in an ignored JSON file mounted read-only.
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./internal/config/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_CONTAINER_PATH=/run/secrets/firebase-service-account.json

# Frontend build-time configuration. Firebase web identifiers are public, but
# keeping them here prevents project-specific values from being hardcoded.
# Empty app/API URLs use the current browser origin.
VITE_API_BASE_URL=
VITE_APP_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_DEMO_MODE=false
