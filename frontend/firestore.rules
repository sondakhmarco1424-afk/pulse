rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Alert schema validation helper
    function isValidAlert(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId == request.auth.uid
        && data.symbol is string && data.symbol.size() <= 12
        && data.priceThreshold is number
        && (data.condition == 'ABOVE' || data.condition == 'BELOW')
        && data.triggered is bool
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Rules for User Alerts collection
    match /alerts/{alertId} {
      // Get single alert (only if owned by the authenticated user)
      allow get: if isSignedIn() && isValidId(alertId) && existing().userId == request.auth.uid;

      // Secure List Query (forces client to query only their own alerts)
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Create new alert
      allow create: if isSignedIn()
        && isValidId(alertId)
        && alertId == incoming().id
        && isValidAlert(incoming())
        && (
          incoming().keys().size() == 7 ||
          (incoming().keys().size() == 8 && incoming().triggeredAt is string && incoming().triggeredAt.size() <= 50)
        );

      // Update alert (e.g. marking as triggered or updating price)
      allow update: if isSignedIn()
        && isValidId(alertId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && isValidAlert(incoming())
        && (
          // Action 1: Mark as triggered
          (incoming().diff(existing()).affectedKeys().hasOnly(['triggered', 'triggeredAt'])) ||
          // Action 2: Edit alert parameters
          (incoming().diff(existing()).affectedKeys().hasOnly(['priceThreshold', 'condition', 'triggered', 'triggeredAt']))
        );

      // Delete alert
      allow delete: if isSignedIn() && isValidId(alertId) && existing().userId == request.auth.uid;
    }
  }
}
