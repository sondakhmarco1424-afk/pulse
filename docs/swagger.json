{
    "swagger": "2.0",
    "info": {
        "description": "This is the API server for the Pulse Real-Time Crypto Alert Aggregation Engine.",
        "title": "Pulse Real-Time Crypto Alert Engine API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8081",
    "basePath": "/api/v1",
    "paths": {
        "/alerts": {
            "get": {
                "description": "Retrieves all price alerts (both pending and triggered) for a user based on requester email.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Alerts"
                ],
                "summary": "List alerts for a user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Requester Email",
                        "name": "requester",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of alerts retrieved successfully",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Alert"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request (e.g. Missing requester)",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/alerts/cancel": {
            "post": {
                "description": "Cancels a pending price alert for a user based on requester, symbol, and price.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Alerts"
                ],
                "summary": "Cancel an active price alert",
                "parameters": [
                    {
                        "description": "Alert Cancellation Request Details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.AlertsRequestRaw"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Alert cancelled successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request (e.g. Validation or not found)",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/alerts/create": {
            "post": {
                "description": "Creates a new pending price alert for a user, validating that no pending alerts already exist for the symbol.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Alerts"
                ],
                "summary": "Create a price alert",
                "parameters": [
                    {
                        "description": "Alert Creation Request Details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.AlertsRequestRaw"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Alert created successfully",
                        "schema": {
                            "$ref": "#/definitions/models.Alert"
                        }
                    },
                    "400": {
                        "description": "Bad Request (e.g. Validation or duplicates)",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/binance/history": {
            "get": {
                "description": "Fetches recent price tick history (up to 100 entries per symbol) from Redis cache for graphs.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Binance"
                ],
                "summary": "Get price history of subscribed symbols",
                "responses": {
                    "200": {
                        "description": "A map of symbol to their historic tick array",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {}
                            }
                        }
                    },
                    "500": {
                        "description": "Error message",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/fcm/subscribe": {
            "post": {
                "description": "Subscribes a client's FCM device token to their personal notification topic.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Alerts"
                ],
                "summary": "Subscribe FCM token to user topic",
                "parameters": [
                    {
                        "description": "FCM Subscription Request Details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.FCMSubscribeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Subscribed successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Alert": {
            "type": "object",
            "properties": {
                "active_requester": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "error_message": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "latest_price": {
                    "type": "number"
                },
                "notification_status": {
                    "description": "\"PENDING\", \"TRIGGERED\", \"CANCELLED\", \"FAILED\"",
                    "type": "string"
                },
                "price_trigger": {
                    "type": "number"
                },
                "requester": {
                    "type": "string"
                },
                "symbol": {
                    "type": "string"
                },
                "trigger_direction": {
                    "description": "\"ABOVE\", \"BELOW\"",
                    "type": "string"
                },
                "triggered_at": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "models.AlertsRequestRaw": {
            "type": "object",
            "properties": {
                "price": {
                    "type": "string"
                },
                "range": {
                    "type": "string"
                },
                "requester": {
                    "type": "string"
                },
                "show_all": {
                    "type": "boolean"
                },
                "status": {
                    "type": "string"
                },
                "symbol": {
                    "type": "string"
                },
                "trigger_direction": {
                    "type": "string"
                }
            }
        },
        "models.FCMSubscribeRequest": {
            "type": "object",
            "required": [
                "email",
                "token"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            }
        }
    }
}